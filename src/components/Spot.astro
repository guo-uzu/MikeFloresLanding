---
import {Image} from "astro:assets"
import MCLogoOrange from "@assets/MCLogoOrange.svg"
import Laser from "@assets/Laser.webp"
import VideoTop from "@assets/VideoTop.webp"
---
<section class="relative overflow-hidden">
    <div class="max-w-[1000px] mx-auto py-20 max-[900px]:pt-0 px-6">
        <div class="flex items-center max-[900px]:flex-col relative">
            <div class="relative flex-2 max-[900px]:-top-6">
                <Image class="relative hidden max-[900px]:flex" src={VideoTop} alt="" />
                <div class="max-[900px]:w-full max-[900px]:bg-transparent max-[900px]:absolute max-[900px]:top-[20%] relative z-10 w-full rounded-l-lg max-[900px]:rounded-lg px-10 max-[900px]:px-0 py-16 max-[900px]:py-0 flex-2 flex flex-col items-center text-3xl max-[900px]:text-[4vw] text-center bg-orange-50 font-anton uppercase font-black text-orange-500 max-[900px]:gap-2">
                    <Image class="w-full max-w-[100px] pb-6 max-[900px]:hidden" src={MCLogoOrange} alt=""/>
                    <p class="text-orange-50 bg-orange-500 w-fit px-2">en la bancada nuevo león</p>
                    <p>estamos trabajando por los temas</p>
                    <p>que a ti más te importan como</p>
                    <p class="text-orange-50 bg-orange-500 w-fit px-2">la seguridad, las niñas y niños</p>
                    <p><span>y el medio ambiente</span></p>
                    <Image class="w-full max-[900px]:w-[20vw]  max-w-[100px] pb-6 hidden max-[900px]:block pt-2" src={MCLogoOrange} alt=""/>
                </div>
                <Image class="max-[900px]:hidden absolute top-0 -translate-y-[50%] z-0" src={Laser} alt="" />
                <Image class="max-[900px]:hidden absolute bottom-0 translate-y-[50%] z-0" src={Laser} alt="" />
            </div>
            <div class="flex items-center relative z-20">
              <iframe class="rounded-xl aspect-9/16 w-auto max-[900px]:w-[400px] max-[600px]:w-full h-auto shadow-3xl" src="https://www.youtube.com/embed/HmzQOUYAPhI" title="En la Bancada Nuevo León sí chambeamos" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
            </div>
        </div>
    </div>
    <Image class="max-[900px]:hidden absolute w-full mx-auto top-0 -translate-y-[50%] z-0" src={Laser} alt="" />
    <Image class="absolute w-full mx-auto bottom-0 translate-y-[50%] z-0" src={Laser} alt="" />
</section>

<style>
section {
    background-image: url("../assets/HeroNoise.webp");
    background-origin: border-box;
    background-size: cover;
    background-repeat: rounded;
}
</style>
