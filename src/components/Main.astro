---
import { Image } from "astro:assets"
import HeroSection from "./HeroSection.tsx"
import Carousel from "./Carousel.tsx"
import Spot from "./Spot.astro"
import CarouselTrabajo from "./CarouselTrabajo.tsx"
import Todos from "@assets/Todos.webp"
import TodosMobile from "@assets/TodosMobile.webp"
import Columna from "./Columna.tsx"
import Contacto from "./Contacto.tsx"
import TextImage from "@assets/TextImage.svg"
---
<main>
    <HeroSection client:only="react" />
    <Carousel client:only="react"/>
    <Spot />
    <CarouselTrabajo client:only="react"/>
    <section class="relative w-full h-full max-h-[800px] max-[650px]:max-h-full flex">
        <Image class="w-0 grow object-cover max-[650px]:hidden" src={Todos} alt="" />
        <Image class="hidden max-[650px]:block" src={TodosMobile} alt="" />
        <Image class="hidden max-[650px]:block absolute bottom-0" src={TextImage} alt="" />
    </section>
    <Columna client:only="react"/>
    <Contacto client:only="react"/>
</main>

