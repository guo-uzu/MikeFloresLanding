---
import {Image} from "astro:assets"
import HeroMike from "@assets/HeroMF.webp"
import HeroTextMike from "@assets/TextHeroMF.webp"
---
<section id="Hero" class="flex relative max-h-[700px]">
       <Image class=" w-0 grow object-cover" src={HeroMike} alt="Mike Hero Section" /> 
      <Image class="absolute w-[38%] top-[18%] right-[8%]" src={HeroTextMike} alt="Mike Hero Section" /> 
</section>

<style>
section {
    background-image: url("../assets/HeroNoise.webp");
    background-origin: border-box;
    background-size: cover;
    background-repeat: no-repeat;
}
</style>
